// Modelo de dados do Recicla+ (Plano de Projeto, seção 8)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  PERSON
  COMPANY
  ADMIN
}

// Máquina de estados (seção 9): AVAILABLE → IN_COLLECTION → COLLECTED; AVAILABLE/IN_COLLECTION → CANCELLED
enum OccurrenceStatus {
  AVAILABLE
  IN_COLLECTION
  COLLECTED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  userType     UserType @default(PERSON) @map("user_type")

  // Foto de perfil: um avatar pronto (avatarPreset) OU uma foto enviada (avatarImage),
  // nunca os dois. avatarUpdatedAt versiona a URL para o cache do navegador.
  avatarPreset    String?   @map("avatar_preset")
  avatarImage     Bytes?    @map("avatar_image")
  avatarImageType String?   @map("avatar_image_type")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  // Preenchido quando a pessoa digita o código recebido por e-mail
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  occurrences        Occurrence[]
  collections        Collection[]
  emailVerification  EmailVerification?
  passwordReset      PasswordReset?
  photos             Photo[]
  notifications      Notification[]     @relation("NotificationRecipient")
  actedNotifications Notification[]     @relation("NotificationActor")

  @@map("users")
}

// Código de confirmação de e-mail em aberto (no máximo um por usuário)
model EmailVerification {
  userId    String   @id @map("user_id") @db.Uuid
  // Hash do código: o código em si só existe no e-mail enviado
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// Código para redefinir a senha ("Esqueci minha senha"), no máximo um por usuário
model PasswordReset {
  userId    String   @id @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Category {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String?
  // Ordem nas listas e filtros ("Outros" sempre por último)
  displayOrder Int     @default(0) @map("display_order")

  subcategories Subcategory[]
  occurrences   Occurrence[]

  @@map("categories")
}

model Subcategory {
  id         Int    @id @default(autoincrement())
  categoryId Int    @map("category_id")
  name       String

  category    Category     @relation(fields: [categoryId], references: [id])
  occurrences Occurrence[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

enum CollectionReleaseReason {
  GAVE_UP // o coletor desistiu
  RELEASED_BY_OWNER // o dono liberou depois de muito tempo parada
}

model Occurrence {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  categoryId        Int              @map("category_id")
  subcategoryId     Int?             @map("subcategory_id")
  description       String?
  estimatedQuantity String?          @map("estimated_quantity")
  latitude          Float
  longitude         Float
  // Coluna antiga (nunca usada); será removida quando nenhuma versão no ar a ler
  legacyPhotoUrl    String?          @map("photo_url")
  // Foto do material, enviada ao informar (opcional)
  photoId           String?          @unique @map("photo_id") @db.Uuid
  status            OccurrenceStatus @default(AVAILABLE)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id])
  photo         Photo?         @relation("OccurrencePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  collections   Collection[]
  notifications Notification[]

  @@index([status, categoryId])
  @@map("occurrences")
}

model Collection {
  id                String                   @id @default(uuid()) @db.Uuid
  occurrenceId      String                   @map("occurrence_id") @db.Uuid
  collectorId       String                   @map("collector_id") @db.Uuid
  collectedQuantity String?                  @map("collected_quantity")
  acceptedAt        DateTime                 @default(now()) @map("accepted_at")
  completedAt       DateTime?                @map("completed_at")
  // Preenchido quando o dono cancela a ocorrência durante a coleta
  cancelledAt       DateTime?                @map("cancelled_at")
  observation       String?
  // Foto do material coletado, enviada ao finalizar (opcional)
  photoId           String?                  @unique @map("photo_id") @db.Uuid
  // Coleta desfeita sem cancelar a ocorrência (ela volta a ficar disponível):
  // o coletor desistiu ou o dono liberou uma coleta parada
  releasedAt        DateTime?                @map("released_at")
  releaseReason     CollectionReleaseReason? @map("release_reason")

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])
  collector  User       @relation(fields: [collectorId], references: [id])
  photo      Photo?     @relation("CollectionPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([occurrenceId])
  @@index([collectorId])
  @@map("collections")
}

// Foto enviada pelo app (já reduzida no celular). Fica numa tabela própria para que as
// listagens não carreguem os bytes e para facilitar mover as fotos para um serviço de
// arquivos no futuro.
model Photo {
  id          String   @id @default(uuid()) @db.Uuid
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  data        Bytes
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  uploader   User        @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  occurrence Occurrence? @relation("OccurrencePhoto")
  collection Collection? @relation("CollectionPhoto")

  @@index([uploadedBy, createdAt])
  @@map("photos")
}

enum NotificationType {
  COLLECTION_CLAIMED // para o dono: alguém assumiu
  COLLECTION_COMPLETED // para o dono: material coletado
  COLLECTION_GAVE_UP // para o dono: o coletor desistiu
  COLLECTION_RELEASED // para o coletor: o dono liberou a coleta
  OCCURRENCE_CANCELLED // para o coletor: o dono cancelou durante a coleta
}

// Aviso no sininho: algo aconteceu com uma ocorrência que envolve a pessoa
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  occurrenceId String           @map("occurrence_id") @db.Uuid
  // Quem causou o aviso (ex.: o coletor que assumiu)
  actorId      String           @map("actor_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  readAt       DateTime?        @map("read_at")

  user       User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
