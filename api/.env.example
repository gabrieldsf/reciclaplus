# Neon → Dashboard → Connect. Copie as duas strings (com e sem "Connection pooling").
# Conexão com pooling (o host contém "-pooler"), usada pela aplicação
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Conexão direta (sem "-pooler"), usada pelas migrations do Prisma
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

PORT=3333
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo"
CORS_ORIGIN="http://localhost:5173"

# E-mail (código de confirmação) via Brevo: SMTP & API → API Keys.
# Sem BREVO_API_KEY, o e-mail só aparece no terminal da API (útil em desenvolvimento).
BREVO_API_KEY=""
# Remetente verificado na Brevo (Senders)
EMAIL_FROM=""
EMAIL_FROM_NAME="Recicla+"
